{
  "name": "calcpro",
  "version": "1.0.0",
  "description": "CalcPro - Standard, Scientific Calculator & Multi-Unit Converter for Web, Android, iOS & macOS",
  "main": "index.html",
  "scripts": {
    "start": "npx serve . -l 3000",
    "sync": "node sync-web.js && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "build:apk": "node sync-web.js && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "keywords": [
    "calculator",
    "scientific",
    "unit-converter",
    "pwa",
    "capacitor",
    "android",
    "ios",
    "macos"
  ],
  "author": "Dabeltech",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/cli": "^7.0.1",
    "@capacitor/core": "^7.0.1",
    "@capacitor/ios": "^7.0.1"
  }
}
