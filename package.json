{
  "name": "calcpro",
  "productName": "CalcPro",
  "version": "1.0.0",
  "description": "CalcPro - Standard, Scientific Calculator & Multi-Unit Converter for Web, Android, iOS, Windows & macOS",
  "main": "electron/main.js",
  "scripts": {
    "start": "npx serve . -l 3000",
    "sync": "node sync-web.js && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "build:apk": "node sync-web.js && npx cap sync android && cd android && gradlew assembleDebug",
    "desktop": "node sync-web.js && electron .",
    "dist:win": "node sync-web.js && electron-builder --win nsis portable --publish never",
    "dist:mac": "node sync-web.js && electron-builder --mac dmg --publish never"
  },
  "keywords": [
    "calculator",
    "scientific",
    "unit-converter",
    "pwa",
    "capacitor",
    "electron",
    "android",
    "ios",
    "macos",
    "windows"
  ],
  "author": "Dabeltech",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3"
  },
  "build": {
    "appId": "com.dabeltech.calcpro",
    "productName": "CalcPro",
    "copyright": "Copyright © 2026 Dabeltech",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "www/**",
      "icons/**",
      "package.json"
    ],
    "icon": "icons/icon-512.png",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CalcPro",
      "artifactName": "CalcPro-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "CalcPro-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "dmg": {
      "artifactName": "CalcPro-${version}-mac-${arch}.dmg"
    }
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}
